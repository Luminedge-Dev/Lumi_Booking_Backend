{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",

    "allowJs": true,
    "checkJs": false,
    "noEmit": true,

    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "types": ["node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/migration/**/*.ts", "_migration/stage17-neon-discover-once.ts", "_migration/stage17-readonly-preflight-once.ts",
    "_migration/stage17-connection-bound-attest-once.ts"],
  "exclude": ["node_modules", ".vercel", "dist"]
}
