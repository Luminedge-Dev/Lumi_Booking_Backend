# Copy to .env for local development. Do not put real secrets in this file.
# On Vercel, set these in the project environment. Never commit .env.

# Required. New MongoDB cluster only. No fallback URI exists in code.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER_HOST/luminedge?retryWrites=true&w=majority

# Optional. Defaults to luminedge when unset.
MONGODB_DB_NAME=luminedge

# Keep OFF during normal portal use. Only the exact value "1" freezes new
# bookings, booking cancellations, and schedule creation (HTTP 423). Absent or
# "0" leaves normal behavior enabled. Production must remain OFF until an
# explicitly authorized ERP cutover. On Vercel, changing this value requires a
# redeployment before the new setting takes effect.
BOOKING_FROZEN=0

PORT=5000
# MUST be "production" on Vercel: it makes the login cookie Secure/SameSite=None,
# enforces the required variables below, and empties the CORS allowlist when
# CORS_ORIGINS is unset. Vercel does not set it for you.
NODE_ENV=development

# Required when NODE_ENV=production. Comma-separated browser origins, no paths.
CORS_ORIGINS=https://NEW_FRONTEND_ORIGIN

# Required when NODE_ENV=production. Portal origin used in account emails.
FRONTEND_URL=https://NEW_FRONTEND_ORIGIN

# Optional, development only (NODE_ENV not production, CORS_ORIGINS unset). Local frontend origin for CORS;
# defaults to http://localhost:3000. Exact-origin matching; never added automatically in production.
FRONTEND_URL_LOCAL=http://localhost:3000

# Required when NODE_ENV=production. Full URL of the frontend reset page.
RESET_PASS_LINK=https://NEW_FRONTEND_ORIGIN/reset-password

# Required. Use long random values. Do not reuse previous deployment secrets.
JWT_SECRET=replace-with-a-long-random-secret
JWT_RESET_PASS_SECRET=replace-with-a-different-long-random-secret
EXPIRES_IN=7d
JWT_RESET_PASS_TOKEN_EXPIRES_IN=15m

# SMTP. EMAIL/APP_PASS and SMTP_EMAIL/SMTP_APP_PASS are both accepted.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL=mailer@example.com
APP_PASS=replace-with-smtp-password
EMAIL_FROM=noreply@example.com

# Required for signed reminder continuations. Reminder delivery fails closed when absent.
CRON_SECRET=replace-with-a-long-random-secret

# Required by FIX-05 reminder delivery. Production must use the public HTTPS API origin.
PUBLIC_API_URL=https://api.example.com

# Set to true on Vercel so cold starts never create/alter indexes. Indexes are
# created only by running scripts/ensure-indexes.js deliberately.
SKIP_INDEX_ENSURE_ON_BOOT=false
