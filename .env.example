# Luminedge Booking Backend — environment template (NO VALUES HERE)
#
# Copy to `.env` and fill in real values locally. `.env` is gitignored AND
# must be excluded from every manually created ZIP/archive (gitignore does
# NOT protect manual archives). Never commit real secrets.
#
# Required at startup (both legacy index.js and TS candidate fail fast):
MONGODB_URI=
JWT_SECRET=
JWT_RESET_PASS_SECRET=
#
# Optional runtime:
PORT=
NODE_ENV=
# Candidate CORS allowlist. Comma-separated origins. Required by the TS
# candidate at bootstrap. Not read by legacy app.js.
CORS_ORIGINS=
# Express trust proxy hop count. Unset means 1. Malformed values fail closed.
TRUST_PROXY_HOPS=
# Pooled Neon runtime URL for PrismaNeon. Not required by Mongo bootstrap.
# Do not put a production database URL here.
NEON_DB_URL=
# Direct unpooled Neon URL for Prisma CLI migrations. Same compute as
# NEON_DB_URL, without the -pooler host suffix.
NEON_DIRECT_URL=
EXPIRES_IN=
JWT_RESET_PASS_TOKEN_EXPIRES_IN=
RESET_PASS_LINK=
SKIP_INDEX_ENSURE_ON_BOOT=
#
# Optional email (warn-and-degrade when absent; never blocks startup):
SMTP_HOST=
SMTP_HOST=
SMTP_SECURE=
EMAIL=
APP_PASS=
EMAIL_FROM=
SMTP_REJECT_UNAUTHORIZED=
#
# Optional operations:
CRON_SECRET=
SLOW_REQUEST_THRESHOLD_MS=
SLOW_DB_OPERATION_THRESHOLD_MS=
